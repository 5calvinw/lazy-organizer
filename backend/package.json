{
  "name": "lazy-organizer-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "prisma db push && node --env-file-if-exists=.env --watch src/server.js",
    "start": "prisma db push && node --env-file-if-exists=.env src/server.js",
    "lint": "node --check src/server.js && node --check src/auth.js && node --check src/mcp.js && node --check src/store.js && node --check src/google-sync.js",
    "test": "node --test tests/*.test.js",
    "build": "npm run db:generate && npm run lint",
    "check:mcp": "node --env-file-if-exists=.env scripts/check-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.2",
    "better-auth": "^1.7.19",
    "express": "^5.1.0",
    "prisma": "^6.19.2",
    "zod": "^4.4.3"
  }
}
