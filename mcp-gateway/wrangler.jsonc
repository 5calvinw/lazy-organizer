{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organizer-mcp-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://organizer.calvinwu.com",
    "ACCESS_ISSUER": "https://shiny-wind-cc1e.cloudflareaccess.com",
    "ACCESS_AUD": "d04aa8dba2a0943f914bb09d55debc95b123c3f722cdec8130e38e3ac343f27a",
    "OWNER_EMAIL": "calvinthewu@gmail.com",
    "ORIGIN_MCP_URL": "https://replace-with-access-protected-origin.invalid/mcp"
  },
  // No production routes; creating the durable storage also requires approval.
  "durable_objects": { "bindings": [{ "name": "OAUTH_STATE", "class_name": "OAuthState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OAuthState"] }],
  "ratelimits": [{
    "name": "AUTH_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }]
}
